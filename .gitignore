*.mp3
.DS_Store
/docs/
.claude/

# Runtime + model caches (regenerated by setup.sh / download_models.sh)
hf_cache/
*.log
*.pid
code/ravensdr/models/decoder_assets/
code/ravensdr/data/emitter_db.json
code/ravensdr/data/meteor_log.json
code/ravensdr/data/observations.json
# Locally-collected IQ/spectrogram training captures (per-node, regenerated)
code/ml/signal_classifier/data/collected/
# Samples rejected as mislabelled (HF with no antenna, synthetic artifacts)
code/ml/signal_classifier/data/quarantine/
# Per-node runtime state (secondary dongle task, startup preset)
code/ravensdr/config.json
# Generated images (WEFAX charts, APT satellite passes)
code/static/images/
# Locally-cloned driver/SDR source trees (built by setup.sh)
/rtl-sdr/

# Trained model — 8.6MB binary, rebuilt from the corpus by the ML pipeline
code/ravensdr/models/signal_classifier.onnx

# Browser UI snapshots (code/scripts/ui_snapshot.py)
.ui-snapshots/
